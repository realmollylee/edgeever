#!/bin/bash

# EdgeEver Docker 应用生命周期脚本。
# start/stop 由飞牛 fnOS 依据 config/resource 中的 docker-project 资源处理，
# 本脚本只需准确上报运行状态。CONTAINER_NAME 必须与
# app/docker/docker-compose.yaml 中的 container_name 一致。

CONTAINER_NAME="edgeever"

is_running() {
  docker inspect "$CONTAINER_NAME" 2>/dev/null | grep -q '"Status": "running"'
}

case "$1" in
  start)
    # do nothing, docker application will be started by appcenter
    exit 0
    ;;
  stop)
    # do nothing, docker application will be stopped by appcenter
    exit 0
    ;;
  status)
    if is_running; then
      exit 0
    fi
    exit 3
    ;;
  *)
    echo "Unknown command: $1" > "$TRIM_TEMP_LOGFILE"
    exit 1
    ;;
esac
