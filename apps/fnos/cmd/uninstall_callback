#!/bin/bash

# 卸载清理后执行。根据卸载向导选择（wizard_keep_data）决定是否删除应用数据。
# - yes（默认）：保留数据。笔记与附件保留在共享数据目录
#   （/volx/@appshare/edgeever/data），重新安装后可继续使用。
# - no：删除共享数据目录内容。
# 运行时数据目录（TRIM_PKGVAR）随应用目录由系统清理，此处只处理用户数据。

KEEP_DATA="${wizard_keep_data:-yes}"

if [ "$KEEP_DATA" = "no" ]; then
    # 共享数据目录（data-share 声明的 edgeever/data，取第一个路径）
    SHARE_DIR="${TRIM_DATA_SHARE_PATHS%%:*}"

    # 防御性校验：仅当路径非空、非根目录且包含应用名时才删除
    if [ -n "$SHARE_DIR" ] && [ "$SHARE_DIR" != "/" ] && [[ "$SHARE_DIR" == *"edgeever"* ]]; then
        if [ -d "$SHARE_DIR" ]; then
            rm -rf "$SHARE_DIR"
            echo "已删除应用数据目录: $SHARE_DIR" > "$TRIM_TEMP_LOGFILE"
        fi
    fi
fi

exit 0
